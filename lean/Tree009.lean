def rank9 (u : Vertex) : Nat := getPacked 5 128 ranks9 u.val
def slot9 (u : Vertex) : Nat := getPacked 4 128 slots9 u.val
def parent9 (u : Vertex) : Vertex := neighborAt u (slot9 u)
def entry9 (v : Vertex) : Bool := decide (rank9 v ≤ budget ⟨9, by decide⟩ ∧
    (v = root ⟨9, by decide⟩ ∨ (slot9 v < degree v ∧ rank9 (parent9 v) + 1 ≤ rank9 v)))
def reduced9_entry (u : Vertex) : Bool := entry9 u
def reduced9_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced9_entry (vertex i) else true)
