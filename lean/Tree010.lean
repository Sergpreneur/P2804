theorem reduced10 (u : Vertex) : reduced10_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced10_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked10 : ∀ v : Vertex, rank10 v ≤ budget ⟨10, by decide⟩ ∧
    (v = root ⟨10, by decide⟩ ∨ (Adj v (parent10 v) ∧ rank10 (parent10 v) + 1 ≤ rank10 v)) := by
  intro v
  have h : rank10 v ≤ budget ⟨10, by decide⟩ ∧ (v = root ⟨10, by decide⟩ ∨ (slot10 v < degree v ∧ rank10 (parent10 v) + 1 ≤ rank10 v)) := of_decide_eq_true (reduced10 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot10 v) step.1, step.2⟩
