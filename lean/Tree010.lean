def rank10 (u : Vertex) : Nat := getPacked 5 128 ranks10 u.val
def slot10 (u : Vertex) : Nat := getPacked 4 128 slots10 u.val
def parent10 (u : Vertex) : Vertex := neighborAt u (slot10 u)
def entry10 (v : Vertex) : Bool := decide (rank10 v ≤ budget ⟨10, by decide⟩ ∧
    (v = root ⟨10, by decide⟩ ∨ (slot10 v < degree v ∧ rank10 (parent10 v) + 1 ≤ rank10 v)))
def reduced10_entry (u : Vertex) : Bool := entry10 u
def reduced10_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced10_entry (vertex i) else true)
