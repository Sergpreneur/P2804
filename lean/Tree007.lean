def rank7 (u : Vertex) : Nat := getPacked 5 128 ranks7 u.val
def slot7 (u : Vertex) : Nat := getPacked 4 128 slots7 u.val
def parent7 (u : Vertex) : Vertex := neighborAt u (slot7 u)
def entry7 (v : Vertex) : Bool := decide (rank7 v ≤ budget ⟨7, by decide⟩ ∧
    (v = root ⟨7, by decide⟩ ∨ (slot7 v < degree v ∧ rank7 (parent7 v) + 1 ≤ rank7 v)))
def reduced7_entry (u : Vertex) : Bool := entry7 u
def reduced7_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced7_entry (vertex i) else true)
