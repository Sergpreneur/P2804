theorem reduced7 (u : Vertex) : reduced7_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced7_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked7 : ∀ v : Vertex, rank7 v ≤ budget ⟨7, by decide⟩ ∧
    (v = root ⟨7, by decide⟩ ∨ (Adj v (parent7 v) ∧ rank7 (parent7 v) + 1 ≤ rank7 v)) := by
  intro v
  have h : rank7 v ≤ budget ⟨7, by decide⟩ ∧ (v = root ⟨7, by decide⟩ ∨ (slot7 v < degree v ∧ rank7 (parent7 v) + 1 ≤ rank7 v)) := of_decide_eq_true (reduced7 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot7 v) step.1, step.2⟩
