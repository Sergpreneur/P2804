def rank3 (u : Vertex) : Nat := getPacked 5 128 ranks3 u.val
def slot3 (u : Vertex) : Nat := getPacked 4 128 slots3 u.val
def parent3 (u : Vertex) : Vertex := neighborAt u (slot3 u)
def entry3 (v : Vertex) : Bool := decide (rank3 v ≤ budget ⟨3, by decide⟩ ∧
    (v = root ⟨3, by decide⟩ ∨ (slot3 v < degree v ∧ rank3 (parent3 v) + 1 ≤ rank3 v)))
def reduced3_entry (u : Vertex) : Bool := entry3 u
def reduced3_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced3_entry (vertex i) else true)
