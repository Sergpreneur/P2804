theorem reduced3 (u : Vertex) : reduced3_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced3_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked3 : ∀ v : Vertex, rank3 v ≤ budget ⟨3, by decide⟩ ∧
    (v = root ⟨3, by decide⟩ ∨ (Adj v (parent3 v) ∧ rank3 (parent3 v) + 1 ≤ rank3 v)) := by
  intro v
  have h : rank3 v ≤ budget ⟨3, by decide⟩ ∧ (v = root ⟨3, by decide⟩ ∨ (slot3 v < degree v ∧ rank3 (parent3 v) + 1 ≤ rank3 v)) := of_decide_eq_true (reduced3 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot3 v) step.1, step.2⟩
