theorem reduced11 (u : Vertex) : reduced11_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced11_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked11 : ∀ v : Vertex, rank11 v ≤ budget ⟨11, by decide⟩ ∧
    (v = root ⟨11, by decide⟩ ∨ (Adj v (parent11 v) ∧ rank11 (parent11 v) + 1 ≤ rank11 v)) := by
  intro v
  have h : rank11 v ≤ budget ⟨11, by decide⟩ ∧ (v = root ⟨11, by decide⟩ ∨ (slot11 v < degree v ∧ rank11 (parent11 v) + 1 ≤ rank11 v)) := of_decide_eq_true (reduced11 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot11 v) step.1, step.2⟩
