theorem reduced2 (u : Vertex) : reduced2_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced2_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked2 : ∀ v : Vertex, rank2 v ≤ budget ⟨2, by decide⟩ ∧
    (v = root ⟨2, by decide⟩ ∨ (Adj v (parent2 v) ∧ rank2 (parent2 v) + 1 ≤ rank2 v)) := by
  intro v
  have h : rank2 v ≤ budget ⟨2, by decide⟩ ∧ (v = root ⟨2, by decide⟩ ∨ (slot2 v < degree v ∧ rank2 (parent2 v) + 1 ≤ rank2 v)) := of_decide_eq_true (reduced2 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot2 v) step.1, step.2⟩
