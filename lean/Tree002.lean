def rank2 (u : Vertex) : Nat := getPacked 5 128 ranks2 u.val
def slot2 (u : Vertex) : Nat := getPacked 4 128 slots2 u.val
def parent2 (u : Vertex) : Vertex := neighborAt u (slot2 u)
def entry2 (v : Vertex) : Bool := decide (rank2 v ≤ budget ⟨2, by decide⟩ ∧
    (v = root ⟨2, by decide⟩ ∨ (slot2 v < degree v ∧ rank2 (parent2 v) + 1 ≤ rank2 v)))
def reduced2_entry (u : Vertex) : Bool := entry2 u
def reduced2_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced2_entry (vertex i) else true)
