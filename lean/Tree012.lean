theorem reduced12 (u : Vertex) : reduced12_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced12_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked12 : ∀ v : Vertex, rank12 v ≤ budget ⟨12, by decide⟩ ∧
    (v = root ⟨12, by decide⟩ ∨ (Adj v (parent12 v) ∧ rank12 (parent12 v) + 1 ≤ rank12 v)) := by
  intro v
  have h : rank12 v ≤ budget ⟨12, by decide⟩ ∧ (v = root ⟨12, by decide⟩ ∨ (slot12 v < degree v ∧ rank12 (parent12 v) + 1 ≤ rank12 v)) := of_decide_eq_true (reduced12 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot12 v) step.1, step.2⟩
