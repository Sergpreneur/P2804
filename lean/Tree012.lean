def rank12 (u : Vertex) : Nat := getPacked 5 128 ranks12 u.val
def slot12 (u : Vertex) : Nat := getPacked 4 128 slots12 u.val
def parent12 (u : Vertex) : Vertex := neighborAt u (slot12 u)
def entry12 (v : Vertex) : Bool := decide (rank12 v ≤ budget ⟨12, by decide⟩ ∧
    (v = root ⟨12, by decide⟩ ∨ (slot12 v < degree v ∧ rank12 (parent12 v) + 1 ≤ rank12 v)))
def reduced12_entry (u : Vertex) : Bool := entry12 u
def reduced12_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced12_entry (vertex i) else true)
