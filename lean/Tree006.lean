  intro v
  have h : rank6 v ≤ budget ⟨6, by decide⟩ ∧ (v = root ⟨6, by decide⟩ ∨ (slot6 v < degree v ∧ rank6 (parent6 v) + 1 ≤ rank6 v)) := of_decide_eq_true (reduced6 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot6 v) step.1, step.2⟩
