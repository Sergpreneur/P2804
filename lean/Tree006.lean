def rank6 (u : Vertex) : Nat := getPacked 5 128 ranks6 u.val
def slot6 (u : Vertex) : Nat := getPacked 4 128 slots6 u.val
def parent6 (u : Vertex) : Vertex := neighborAt u (slot6 u)
def entry6 (v : Vertex) : Bool := decide (rank6 v ≤ budget ⟨6, by decide⟩ ∧
    (v = root ⟨6, by decide⟩ ∨ (slot6 v < degree v ∧ rank6 (parent6 v) + 1 ≤ rank6 v)))
def reduced6_entry (u : Vertex) : Bool := entry6 u
def reduced6_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced6_entry (vertex i) else true)
