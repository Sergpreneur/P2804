theorem reduced8 (u : Vertex) : reduced8_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced8_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked8 : ∀ v : Vertex, rank8 v ≤ budget ⟨8, by decide⟩ ∧
    (v = root ⟨8, by decide⟩ ∨ (Adj v (parent8 v) ∧ rank8 (parent8 v) + 1 ≤ rank8 v)) := by
  intro v
  have h : rank8 v ≤ budget ⟨8, by decide⟩ ∧ (v = root ⟨8, by decide⟩ ∨ (slot8 v < degree v ∧ rank8 (parent8 v) + 1 ≤ rank8 v)) := of_decide_eq_true (reduced8 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot8 v) step.1, step.2⟩
