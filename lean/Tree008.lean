def rank8 (u : Vertex) : Nat := getPacked 5 128 ranks8 u.val
def slot8 (u : Vertex) : Nat := getPacked 4 128 slots8 u.val
def parent8 (u : Vertex) : Vertex := neighborAt u (slot8 u)
def entry8 (v : Vertex) : Bool := decide (rank8 v ≤ budget ⟨8, by decide⟩ ∧
    (v = root ⟨8, by decide⟩ ∨ (slot8 v < degree v ∧ rank8 (parent8 v) + 1 ≤ rank8 v)))
def reduced8_entry (u : Vertex) : Bool := entry8 u
def reduced8_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced8_entry (vertex i) else true)
