def rank5 (u : Vertex) : Nat := getPacked 5 128 ranks5 u.val
def slot5 (u : Vertex) : Nat := getPacked 4 128 slots5 u.val
def parent5 (u : Vertex) : Vertex := neighborAt u (slot5 u)
def entry5 (v : Vertex) : Bool := decide (rank5 v ≤ budget ⟨5, by decide⟩ ∧
    (v = root ⟨5, by decide⟩ ∨ (slot5 v < degree v ∧ rank5 (parent5 v) + 1 ≤ rank5 v)))
def reduced5_entry (u : Vertex) : Bool := entry5 u
def reduced5_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced5_entry (vertex i) else true)
