theorem reduced5 (u : Vertex) : reduced5_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced5_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked5 : ∀ v : Vertex, rank5 v ≤ budget ⟨5, by decide⟩ ∧
    (v = root ⟨5, by decide⟩ ∨ (Adj v (parent5 v) ∧ rank5 (parent5 v) + 1 ≤ rank5 v)) := by
  intro v
  have h : rank5 v ≤ budget ⟨5, by decide⟩ ∧ (v = root ⟨5, by decide⟩ ∨ (slot5 v < degree v ∧ rank5 (parent5 v) + 1 ≤ rank5 v)) := of_decide_eq_true (reduced5 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot5 v) step.1, step.2⟩
