theorem reduced1 (u : Vertex) : reduced1_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced1_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked1 : ∀ v : Vertex, rank1 v ≤ budget ⟨1, by decide⟩ ∧
    (v = root ⟨1, by decide⟩ ∨ (Adj v (parent1 v) ∧ rank1 (parent1 v) + 1 ≤ rank1 v)) := by
  intro v
  have h : rank1 v ≤ budget ⟨1, by decide⟩ ∧ (v = root ⟨1, by decide⟩ ∨ (slot1 v < degree v ∧ rank1 (parent1 v) + 1 ≤ rank1 v)) := of_decide_eq_true (reduced1 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot1 v) step.1, step.2⟩
