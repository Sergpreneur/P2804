def rank1 (u : Vertex) : Nat := getPacked 5 128 ranks1 u.val
def slot1 (u : Vertex) : Nat := getPacked 4 128 slots1 u.val
def parent1 (u : Vertex) : Vertex := neighborAt u (slot1 u)
def entry1 (v : Vertex) : Bool := decide (rank1 v ≤ budget ⟨1, by decide⟩ ∧
    (v = root ⟨1, by decide⟩ ∨ (slot1 v < degree v ∧ rank1 (parent1 v) + 1 ≤ rank1 v)))
def reduced1_entry (u : Vertex) : Bool := entry1 u
def reduced1_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced1_entry (vertex i) else true)
