theorem reduced4 (u : Vertex) : reduced4_entry u = true := by
  have hi : u.val / 64 < 128 := by have := u.isLt; omega
  have h := reduced4_chunks ⟨u.val / 64, hi⟩
  have hj : u.val % 64 < 2^6 := by omega
  have hh := checkBlock_sound _ 6 ((u.val / 64)*64) h (u.val % 64) hj
  have eq : u.val / 64 * 64 + u.val % 64 = u.val := by omega
  simpa only [eq, if_pos u.isLt, vertex_val] using hh
theorem checked4 : ∀ v : Vertex, rank4 v ≤ budget ⟨4, by decide⟩ ∧
    (v = root ⟨4, by decide⟩ ∨ (Adj v (parent4 v) ∧ rank4 (parent4 v) + 1 ≤ rank4 v)) := by
  intro v
  have h : rank4 v ≤ budget ⟨4, by decide⟩ ∧ (v = root ⟨4, by decide⟩ ∨ (slot4 v < degree v ∧ rank4 (parent4 v) + 1 ≤ rank4 v)) := of_decide_eq_true (reduced4 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot4 v) step.1, step.2⟩
