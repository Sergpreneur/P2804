def rank4 (u : Vertex) : Nat := getPacked 5 128 ranks4 u.val
def slot4 (u : Vertex) : Nat := getPacked 4 128 slots4 u.val
def parent4 (u : Vertex) : Vertex := neighborAt u (slot4 u)
def entry4 (v : Vertex) : Bool := decide (rank4 v ≤ budget ⟨4, by decide⟩ ∧
    (v = root ⟨4, by decide⟩ ∨ (slot4 v < degree v ∧ rank4 (parent4 v) + 1 ≤ rank4 v)))
def reduced4_entry (u : Vertex) : Bool := entry4 u
def reduced4_chunk (j : Nat) : Bool := checkBlock 6 (j*64) (fun i => if i < 4824 then reduced4_entry (vertex i) else true)
