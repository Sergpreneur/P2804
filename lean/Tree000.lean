  intro v
  have h : rank0 v ≤ budget ⟨0, by decide⟩ ∧ (v = root ⟨0, by decide⟩ ∨ (slot0 v < degree v ∧ rank0 (parent0 v) + 1 ≤ rank0 v)) := of_decide_eq_true (reduced0 v)
  refine ⟨h.1, ?_⟩
  rcases h.2 with eq | step
  · exact Or.inl eq
  · exact Or.inr ⟨neighborAt_adj v (slot0 v) step.1, step.2⟩
